  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4e5e70",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation",
        "string.quoted.docstring",
        "string.quoted.docstring.multi"
      ],
      "settings": {
        "foreground": "#627284",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.modifier",
        "storage.type.function",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#b09ec8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#4eabc0"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#54ab98"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "support.variable"
      ],
      "settings": {
        "foreground": "#96bcd4"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#8cb488"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d0927c"
      }
    },
    {
      "name": "Booleans",
      "scope": [
        "constant.language",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#cc7e90"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#aeb6c0"
      }
    }
  ]
}
