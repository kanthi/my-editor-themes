  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6e645c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation",
        "string.quoted.docstring",
        "string.quoted.docstring.multi"
      ],
      "settings": {
        "foreground": "#827870",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.modifier",
        "storage.type.function",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#c4a8c0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#64b8b0"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#6ab49c"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "support.variable"
      ],
      "settings": {
        "foreground": "#a8c4dc"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#a3bc96"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#dca888"
      }
    },
    {
      "name": "Booleans",
      "scope": [
        "constant.language",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#d89090"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#c4bcb4"
      }
    }
  ]
}
