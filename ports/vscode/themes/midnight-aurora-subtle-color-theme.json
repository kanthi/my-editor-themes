  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5a6b7d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation",
        "string.quoted.docstring",
        "string.quoted.docstring.multi"
      ],
      "settings": {
        "foreground": "#6e8093",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.member",
        "variable.other.property",
        "support.variable",
        "meta.definition.variable.name",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#a2c8ec"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable.parameter"
      ],
      "settings": {
        "foreground": "#a2c8ec",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.declaration",
        "keyword.operator.word",
        "storage.modifier",
        "storage.type.function",
        "storage.type.class",
        "storage.type.struct",
        "storage.type.enum",
        "storage.type.interface",
        "storage.type.keyword",
        "keyword.declaration.function",
        "keyword.declaration.class"
      ],
      "settings": {
        "foreground": "#bba8d1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.function.builtin",
        "support.function.magic",
        "variable.function",
        "meta.function-call",
        "entity.name.function.constructor"
      ],
      "settings": {
        "foreground": "#57b5c8"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.union",
        "entity.name.interface",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#5db5a0"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "support.module"
      ],
      "settings": {
        "foreground": "#76c6b3"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.annotation",
        "punctuation.definition.annotation",
        "storage.type.annotation",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#5db5a0"
      }
    },
    {
      "name": "Self / this / super",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.special.self",
        "variable.language.special.cls",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#a2c8ec",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Booleans and language constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "variable.language"
      ],
      "settings": {
        "foreground": "#d68697"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d99c85"
      }
    },
    {
      "name": "Other constants",
      "scope": [
        "constant.other",
        "variable.other.constant",
        "support.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#57b5c8"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#98bf93"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#76c6b3"
      }
    },
    {
      "name": "Escape sequences",
      "scope": [
        "constant.character.escape",
        "constant.character"
      ],
      "settings": {
        "foreground": "#57b5c8"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.section",
        "punctuation.definition.parameters",
        "punctuation.definition.bracket",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#b8c1cc"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.bitwise"
      ],
      "settings": {
        "foreground": "#b8c1cc"
      }
    },
    {
      "name": "Member access",
      "scope": [
        "punctuation.accessor",
        "punctuation.accessor.dot",
        "keyword.operator.member"
      ],
      "settings": {
        "foreground": "#d28e9d"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#bba8d1"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#5db5a0"
      }
    },
    {
      "name": "Object keys and YAML keys",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key",
        "meta.mapping.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#a2c8ec"
      }
    },
    {
      "name": "CSS property values",
      "scope": [
