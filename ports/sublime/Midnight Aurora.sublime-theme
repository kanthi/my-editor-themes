{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "dark_bg": "#131922",
    "medium_dark_bg": "#131922",
    "medium_bg": "#131922",
    "light_bg": "#131922",
    "tabset_dark_bg": "#131922",
    "tabset_medium_dark_bg": "#131922",
    "tabset_medium_bg": "#131922",
    "tabset_light_bg": "#131922",
    "tabset_dark_tint_mod": "color(#e6edf3 a(0.08))",
    "tabset_medium_dark_tint_mod": "color(#e6edf3 a(0.06))",
    "tabset_medium_tint_mod": "color(#000000 a(0.15))",
    "tabset_light_tint_mod": "color(#000000 a(0.10))",
    "file_tab_unselected_label_color": "#7d8c9e",
    "file_tab_selected_label_color": "#e6edf3",
    "file_tab_unselected_light_label_color": "#7d8c9e",
    "file_tab_selected_light_label_color": "#e6edf3",
    "file_tab_angled_unselected_label_color": "#7d8c9e",
    "file_tab_angled_unselected_medium_label_color": "#7d8c9e",
    "adaptive_dividers": "#1c2532",
    "link_fg": "#3ac8e8",
    "icon_tint": "#c5cdd6",
    "icon_light_tint": "color(#c5cdd6 a(0.75))",
    "icon_opacity": {
      "target": 0.75,
      "speed": 4.0,
      "interpolation": "smoothstep"
    },
    "icon_hover_opacity": {
      "target": 1.0,
      "speed": 4.0,
      "interpolation": "smoothstep"
    },
    "tool_tip_bg": "#161e29",
    "tool_tip_fg": "#e6edf3",
    "vcs_added": "#48cba9",
    "vcs_modified": "#f09872",
    "vcs_deleted": "#ec738d",
    "vcs_missing": "#ec738d",
    "vcs_staged": "#3ac8e8",
    "vcs_unmerged": "#f09872",
    "auto_complete_bg_dark_tint": "color(#ffffff a(0.04))",
    "auto_complete_selected_row_dark_tint": "color(#3ac8e8 a(0.22))",
    "auto_complete_text_dark_tint": "#e6edf3",
    "viewport_always_visible_color": "color(#c5cdd6 a(0.18))",
    "viewport_hide_show_color": "color(#c5cdd6 a(0.30))",
    "font_face": "IBM Plex Mono",
    "font_size_sm": 16,
    "font_size": 18,
    "font_size_lg": 18,
    "bg": "#0e1319",
    "bg_chrome": "#131922",
    "bg_panel": "#0c1016",
    "fg": "#c5cdd6",
    "fg_bright": "#e6edf3",
    "status_fg": "#8a99aa",
    "title_fg": "#dce0e5",
    "tab_unselected": "#7d8c9e",
    "sidebar_hover": "#19202a",
    "sidebar_selected": "#202a37",
    "sidebar_selected_hover": "#263242",
    "folder": "#74ade8",
    "button": "#1e2734",
    "button_hover": "#283445",
    "scrollbar": "#38485c",
    "accent": "#3ac8e8"
  },
  "rules": [
    {
      "class": "status_bar",
      "layer0.tint": "var(bg_chrome)",
      "layer0.opacity": 1.0
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "fg": "var(status_fg)",
      "font.face": "IBM Plex Mono",
      "font.size": 13,
      "font.bold": false
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "attributes": [
        "button"
      ],
      "fg": "var(title_fg)"
    },
    {
      "class": "title_bar",
      "fg": "var(title_fg)",
      "bg": "var(bg_chrome)"
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "var(bg_chrome)",
      "layer0.opacity": 1.0
    },
    {
      "class": "sidebar_heading",
      "fg": "var(status_fg)",
      "font.face": "IBM Plex Mono",
      "font.size": 14,
      "font.bold": true
    },
    {
      "class": "sidebar_tree",
      "row_padding": [
        12,
        6
      ],
      "indent": 16,
      "indent_offset": 14,
      "dark_content": true
    },
    {
      "class": "sidebar_label",
      "fg": "var(fg)",
      "font.face": "IBM Plex Mono",
      "font.size": 18,
      "font.bold": false
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selectable",
            "hover"
          ]
        }
      ],
      "fg": "var(fg_bright)"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "var(fg_bright)"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "expandable"
          ]
        }
      ],
      "font.bold": false
    },
    {
      "class": "tree_row",
      "attributes": [
        "selectable",
        "hover"
      ],
      "layer0.tint": "var(sidebar_hover)",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "var(sidebar_selected)",
      "layer0.opacity": 1.0
    },
    {
      "class": "tree_row",
      "attributes": [
        "selected",
        "hover"
      ],
      "layer0.tint": "var(sidebar_selected_hover)",
      "layer0.opacity": 1.0
    },
    {
      "class": "icon_folder",
      "layer0.tint": "var(folder)",
      "layer0.opacity": 0.85
    },
    {
      "class": "icon_folder_loading",
      "layer0.tint": "var(folder)"
    },
    {
      "class": "icon_folder_dup",
      "layer0.tint": "var(folder)"
    },
    {
      "class": "icon_file_type",
      "layer0.opacity": 1.0,
      "content_margin": [
        9,
        9
      ]
    },
    {
      "class": "icon_file_type",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "hover"
          ]
        }
      ],
      "layer0.opacity": 1.0
    },
    {
      "class": "icon_file_type",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "layer0.opacity": 1.0
    },
    {
      "class": "tabset_control",
      "layer0.tint": "var(bg_chrome)",
      "layer0.opacity": 1.0,
      "content_margin": [
        0,
        0,
        0,
        0
      ]
    },
    {
      "class": "tab_control",
      "layer0.tint": "var(bg_chrome)",
      "layer0.opacity": 1.0
    },
    {
      "class": "tab_control",
      "attributes": [
        "selected"
      ],
      "layer0.tint": "var(bg)",
      "layer0.opacity": 1.0
    },
    {
      "class": "tab_label",
      "fg": "var(tab_unselected)",
      "font.face": "IBM Plex Mono",
      "font.size": 15
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "var(fg_bright)",
      "font.face": "IBM Plex Mono",
      "font.size": 15
    },
    {
      "class": "panel_control",
      "layer0.tint": "var(bg)",
      "layer0.opacity": 1.0
    },
    {
      "class": "panel_grid_control",
      "layer0.tint": "var(bg)",
      "layer0.opacity": 1.0
    },
    {
      "class": "overlay_control",
      "layer0.tint": "var(bg_chrome)",
      "layer0.opacity": 1.0
    },
    {
      "class": "scroll_bar_control",
      "layer0.tint": "var(bg)",
      "layer0.opacity": 1.0,
      "blur": false
    },
    {
      "class": "puck_control",
      "layer0.tint": "var(scrollbar)",
      "layer0.opacity": 0.35
    },
    {
      "class": "puck_control",
      "attributes": [
        "hover"
      ],
      "layer0.opacity": 0.5
    },
    {
      "class": "text_line_control",
      "layer0.tint": "var(bg_chrome)",
      "layer0.opacity": 1.0,
      "tint_index": 0
    },
    {
      "class": "button_control",
      "layer0.tint": "var(button)",
      "layer0.opacity": 1.0
    },
    {
      "class": "button_control",
      "attributes": [
        "hover"
      ],
      "layer0.tint": "var(button_hover)"
    },
    {
      "class": "tool_tip_control",
      "layer0.tint": "var(tool_tip_bg)",
      "layer0.opacity": 1.0
    },
    {
      "class": "tool_tip_label_control",
      "fg": "var(tool_tip_fg)"
    }
  ]
}
